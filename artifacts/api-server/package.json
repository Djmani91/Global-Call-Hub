{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:credits": "esbuild src/services/credits.test.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --external:drizzle-orm --external:drizzle-orm/* --external:@replit/connectors-sdk --external:express --external:@clerk/* --external:twilio --outfile=dist/credits.test.mjs && node --test dist/credits.test.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:voice": "esbuild src/services/voice.test.ts --bundle --platform=node --format=esm --external:express --external:@clerk/* --external:twilio --outfile=dist/voice.test.mjs && node --test dist/voice.test.mjs",
    "test:pricing": "esbuild src/services/pricing.test.ts --bundle --platform=node --format=esm --external:express --outfile=dist/pricing.test.mjs && node --test dist/pricing.test.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.90",
    "@clerk/shared": "^4.45.1",
    "@replit/connectors-sdk": "^0.7.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "twilio": "^6.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
